[
  {
    "kernelSource": {
      "name": "kernel_xiaomi_odin",
      "repo": "https://github.com/NOXCIS/kernel_xiaomi_odin",
      "branch": "sukisu-4.1.1",   // 建议使用已集成 SukiSU 的分支，或主线分支由脚本集成
      "device": "odin"
    },
    "withKernelSU": true,          // 必须设为 true 才会执行集成脚本
"toolchains": [
  {
    "name": "clang",
    "repo": "https://github.com/Android-Build-Toolchains/aosp-clang",
    "branch": "main"
  }
],
    "params": {
      "ARCH": "arm64",
      "CROSS_COMPILE": "aarch64-linux-gnu-",
      "CLANG_TRIPLE": "aarch64-linux-gnu-",
      "CC": "clang",
      "AR": "llvm-ar"
    }
  }
]
